diff --git a/scheduler/process.c b/scheduler/process.c
index 7f05a90a..3ef73fe7 100644
--- a/scheduler/process.c
+++ b/scheduler/process.c
@@ -639,6 +639,30 @@ cupsdStartProcess(
 
   cupsdLogMessage(CUPSD_LOG_DEBUG2, "cupsdStartProcess: Calling posix_spawn.");
 
+  /*
+   * Only clear FD_CLOEXEC on fd 3/4 when they are the intended
+   * back/side channel (backfd==3 / sidefd==4). Record original
+   * flags to restore after posix_spawn.
+   */
+  int fd3_cloexec = -1; /* -1 = not touched */
+  int fd4_cloexec = -1;
+
+  if (backfd == 3)
+  {
+    fd3_cloexec = fcntl(3, F_GETFD);
+    cupsdLogMessage(CUPSD_LOG_DEBUG2, "cupsdStartProcess: backfd==3, fd3 flag=%d.", fd3_cloexec);
+    if (fd3_cloexec & FD_CLOEXEC)
+      fcntl(3, F_SETFD, fd3_cloexec & ~FD_CLOEXEC);
+  }
+
+  if (sidefd == 4)
+  {
+    fd4_cloexec = fcntl(4, F_GETFD);
+    cupsdLogMessage(CUPSD_LOG_DEBUG2, "cupsdStartProcess: sidefd==4, fd4 flag=%d.", fd4_cloexec);
+    if (fd4_cloexec & FD_CLOEXEC)
+      fcntl(4, F_SETFD, fd4_cloexec & ~FD_CLOEXEC);
+  }
+
   if (posix_spawn(pid, exec_path, &actions, &attrs, argv, envp ? envp : environ))
   {
     cupsdLogMessage(CUPSD_LOG_ERROR, "Unable to fork %s - %s.", command, strerror(errno));
@@ -648,6 +672,12 @@ cupsdStartProcess(
   else
     cupsdLogMessage(CUPSD_LOG_DEBUG2, "cupsdStartProcess: pid=%d", (int)*pid);
 
+  /* Restore FD_CLOEXEC on fd 3/4 if we cleared it */
+  if (fd3_cloexec != -1)
+    fcntl(3, F_SETFD, fd3_cloexec);
+  if (fd4_cloexec != -1)
+    fcntl(4, F_SETFD, fd4_cloexec);
+
   posix_spawn_file_actions_destroy(&actions);
   posix_spawnattr_destroy(&attrs);
 
diff --git a/scheduler/statbuf.c b/scheduler/statbuf.c
index 5a2530e4..9b71037e 100644
--- a/scheduler/statbuf.c
+++ b/scheduler/statbuf.c
@@ -40,6 +40,28 @@ cupsdStatBufDelete(cupsd_statbuf_t *sb)	/* I - Status buffer */
 }
 
 
+/*
+ * 'cupsdStatBufDeleteForJob()' - Destroy a status buffer.
+ */
+
+void
+cupsdStatBufDeleteForJob(cupsd_statbuf_t *sb)	/* I - Status buffer */
+{
+ /*
+  * Range check input...
+  */
+
+  if (!sb)
+    return;
+
+ /*
+  * Free memory used...
+  */
+
+  free(sb);
+}
+
+
 /*
  * 'cupsdStatBufNew()' - Create a new status buffer.
  */
